# Production environment — copy to .env.prod on the server and fill in.
# NEVER commit .env.prod.
#
# Usage: docker compose -f compose.prod.yml --env-file .env.prod up -d

# Public domain the stack is served on (DNS A/AAAA record must point to the server)
FINYO_DOMAIN=finyo.example.com

# E-mail for Let's Encrypt certificate notifications
ACME_EMAIL=you@example.com

# Docker Hub namespace the finyo-be / finyo-fe images are published under
DOCKERHUB_USERNAME=

# Image versions (default: latest). Pin to a release tag for reproducible deploys.
#FINYO_BE_VERSION=0.1.0
#FINYO_FE_VERSION=0.1.0

# Postgres password for the finyo application database
DB_PASSWORD=

# Postgres password for the keycloak database (created on first start)
KC_DB_PASSWORD=

# Keycloak bootstrap admin (master realm) — used to manage the finyo realm
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=

# Optional: SIX market data API key
SIX_API_KEY=
