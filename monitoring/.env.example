# Monitoring stack environment — copy to .env in this directory and fill in.
# NEVER commit the real .env.

# Public domain for Grafana (needs a DNS A record and the matching
# GRAFANA_DOMAIN entry in the app stack's .env.prod for Caddy routing)
GRAFANA_DOMAIN=grafana.example.com

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
